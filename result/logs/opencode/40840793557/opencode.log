timestamp=2026-10-29T08:33:26.677Z level=INFO run=7291f0d4 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json,re\nd=json.load(open('crawl.json'))\nfrom collections import defaultdict\napi=defaultdict(lambda:{'routes':set(),'methods':set(),'status':set()})\nfor e in d:\n    for a in e['apis']:\n        u=a['url']\n        if 'console.byteplus.com' not in u: continue\n        p=u.split('?')[0]\n        api[p]['routes'].add(e['route']); api[p]['methods'].add(a['method'])\n        if a.get('status'): api[p]['status'].add(a['status'])\n# exclude generic shell endpoints\nshell=re.compile(r'/api/(common|financial|top/(consolemessage|ticket|account_management))/')\nrows=[]\nfor p,v in api.items():\n    if shell.search(p): continue\n    rows.append((p,sorted(v['methods']),len(v['routes'])))\nrows.sort()\nprint('total unique same-origin api paths (non-shell):',len(rows))\n# High value: path has id-ish segment or write verb or sensitive\nkw=re.compile(r'(?i)(create|update|delete|modify|add|remove|associate|disassociate|invite|grant|revoke|role|policy|permission|apikey|api_key|secret|token|account|org|tenant|member|owner|admin|share|import|upload|bind|unbind|\\{[a-z]+\\}|/\\d{4,})')\nprint('\\n=== high-value candidates ===')\nfor p,m,r in rows:\n    if kw.search(p):\n        print(('%s %s  routes=%d'% (','.join(m),p,r)))\nPY" action.permission=* action.action=allow action.pattern=*
