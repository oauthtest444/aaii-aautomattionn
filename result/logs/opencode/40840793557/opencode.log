timestamp=2026-10-29T08:35:46.973Z level=INFO run=7291f0d4 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json,re\nfrom urllib.parse import urlsplit\nd=json.load(open('crawl.json'))\ndef norm(u):\n    try:\n        s=urlsplit(u)\n    except: return None\n    if s.netloc!='console.byteplus.com': return None\n    p=s.path\n    if not p.startswith('/api/'): return None\n    p=re.sub(r'/ap-[a-z0-9-]+/','/{region}/',p)\n    p=re.sub(r'/(cn|us|eu|sa|me|af)-[a-z0-9-]+/','/{region}/',p)\n    return (s.netloc,p)\nagg={}\nfor e in d:\n    for a in e.get('apis',[]):\n        n=norm(a.get('url',''))\n        if not n: continue\n        m=a.get('method') or 'GET'\n        agg.setdefault((m,n[1]),set()).add(e['route'])\nprint('unique api endpoints',len(agg))\n# routes.md\nwith open('/home/runner/work/aaii-aautomattionn/aaii-aautomattionn/result/inventory/routes.md','w') as f:\n    f.write('# Route inventory — console.byteplus.com\\n\\n')\n    f.write('Crawled %d routes (account A). Status = HTTP status of final document.\\n\\n'%len(d))\n    f.write('| # | Route | Final URL | Status | Scripts | APIs | Links |\\n')\n    f.write('|---|-------|-----------|--------|---------|------|-------|\\n')\n    for i,e in enumerate(d,1):\n        f.write('| %d | %s | %s | %s | %d | %d | %d |\\n'%(i,e['route'],e['finalUrl'],e['status'],len(e.get('scripts',[])),len(e.get('apis',[])),len(e.get('links',[]))))\n# endpoints.md\nwith open('/home/runner/work/aaii-aautomattionn/aaii-aautomattionn/result/inventory/endpoints.md','w') as f:\n    f.write('# Endpoint inventory — console.byteplus.com\\n\\n')\n    f.write('Unique same-origin `/api/...` endpoint shapes observed during the %d-route crawl (region segments normalized to `{region}`). %d unique method+path.\\n\\n'%(len(d),len(agg)))\n    f.write('| Method | Path (normalized) | Routes observed |\\n|--------|-------------------|------------------|\\n')\n    for (m,p),rs in sorted(agg.items(), key=lambda x:(x[0][1],x[0][0])):\n        f.write('| %s | `%s` | %d |\\n'%(m,p,len(rs)))\n# dump raw map for json\njson.dump({f'{m} {p}':sorted(rs) for (m,p),rs in agg.items()}, open('/tmp/bp2/endpoints_agg.json','w'), indent=0)\nprint('wrote routes.md, endpoints.md')\nPY" action.permission=* action.action=allow action.pattern=*
