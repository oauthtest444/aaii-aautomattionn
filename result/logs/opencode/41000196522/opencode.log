timestamp=2026-10-30T04:02:53.877Z level=INFO run=d5ec9ac2 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json,urllib.request,random,string,time\ndef req(url,data=None,headers=None,method=None):\n    h={'Content-Type':'application/json','Accept':'application/json'}\n    if headers: h.update(headers)\n    r=urllib.request.Request(url,data=(json.dumps(data).encode() if data is not None else None),headers=h,method=method)\n    with urllib.request.urlopen(r,timeout=20) as resp:\n        return resp.status, resp.read().decode()\ndom='maxxspace.com'\nlocal='qa'+''.join(random.choices(string.ascii_lowercase+string.digits,k=10))\naddr=f'{local}@{dom}'\npw='QaTest!'+''.join(random.choices(string.ascii_letters+string.digits,k=8))\nprint('addr',addr)\ntry:\n    s,b=req('https://api.mail.tm/accounts',{'address':addr,'password':pw})\n    print('create',s,b[:300])\nexcept Exception as e:\n    print('create err',e)\ntry:\n    s,b=req('https://api.mail.tm/token',{'address':addr,'password':pw})\n    print('token',s,b[:200])\n    tok=json.loads(b)['token']\n    open('/tmp/mailtm.json','w').write(json.dumps({'addr':addr,'pw':pw,'token':tok}))\nexcept Exception as e:\n    print('token err',e)\nPY" action.permission=* action.action=allow action.pattern=*
