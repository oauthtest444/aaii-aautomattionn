timestamp=2026-10-29T09:25:37.114Z level=INFO run=5970575e message=evaluated permission=bash pattern="cat > /tmp/opencode/scan.py <<'PY'\nimport os,re,json,sys\nbase='/tmp/opencode/js_cache'\nurls={}\nfor line in open('/tmp/opencode/jslist.txt'):\n    n,u=line.strip().split('|',1)\n    urls[int(n)]=u\ndef ctx(hitpos,text,w=220):\n    return text[max(0,hitpos-w):hitpos+w].replace('\\n',' ')\n# source markers\nsrcpat=re.compile(r'location\\.(?:search|hash)|URLSearchParams|searchParams\\.get|document\\.referrer')\nsinkpat=re.compile(r'dangerouslySetInnerHTML|innerHTML\\s*=|outerHTML\\s*=|insertAdjacentHTML|document\\.write|\\.srcdoc\\s*=|\\beval\\s*\\(|new\\s+Function\\s*\\(')\nhits=[]\nfor f in sorted(os.listdir(base)):\n    if not f.endswith('.js'): continue\n    n=int(f.split('_',1)[0])\n    try: t=open(os.path.join(base,f),encoding='utf-8',errors='ignore').read()\n    except: continue\n    # window scan: for each sink, check source within 600 chars\n    for m in sinkpat.finditer(t):\n        s=max(0,m.start()-700); e=min(len(t),m.end()+700)\n        win=t[s:e]\n        if srcpat.search(win):\n            hits.append({'file':f,'url':urls.get(n,''),'kind':m.group(0)[:40],'ctx':ctx(m.start(),t,350)})\n    # postMessage listeners lacking origin check in window\n    for m in re.finditer(r'addEventListener\\(\\s*[\"\\']message[\"\\']',t):\n        s=m.start(); e=min(len(t),m.end()+900)\n        win=t[s:e]\n        if 'origin' not in win[:700]:\n            hits.append({'file':f,'url':urls.get(n,''),'kind':'message-listener-no-origin-near','ctx':ctx(m.start(),t,400)})\nprint(\"HITS\",len(hits))\nseen=set()\nfor h in hits:\n    k=(h['url'],h['kind'],h['ctx'][:80])\n    if k in seen: continue\n    seen.add(k)\n    print('\\n###',h['kind'],'\\nURL:',h['url'],'\\n',h['ctx'][:900])\nPY" action.permission=* action.action=allow action.pattern=*
