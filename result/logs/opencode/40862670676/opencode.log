timestamp=2026-10-29T11:13:01.331Z level=INFO run=f162cdeb message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json\np='result/testing-inventory.json'\nd=json.load(open(p))\nd.setdefault('routes',[]).append({\n \"url\":\"https://console.byteplus.com/auth/login/\",\n \"status\":\"tested\",\n \"javascript\":[\"https://res.gcloudcache.com/bp-fe/vconsole-auth/byteplus/static/js/1.0.0.2811/main.adbc4e5a.js\"],\n \"notes\":\"Open redirect via redirectURI tab bypass; VULN-20261029-001 (excluded from confirmed-vuln per rule 9)\"\n})\nd.setdefault('flows',[]).append({\n \"source\":\"location.search.redirectURI\",\n \"sink\":\"location.assign / post-login navigation\",\n \"file\":\"main.adbc4e5a.js (vconsole-auth 1.0.0.2811)\",\n \"status\":\"confirmed\",\n \"evidence\":\"result/findings/VULN-20261029-001/\"\n})\nd.setdefault('endpoints',[]).append({\n \"method\":\"POST\",\"path\":\"/api/passport/login/mixtureLogin\",\"auth\":\"public\",\n \"variants\":[\"redirectURI tab-bypass\"],\"status\":\"confirmed\"\n})\njson.dump(d,open(p,'w'),indent=2)\nprint('inventory updated')\nPY" action.permission=* action.action=allow action.pattern=*
