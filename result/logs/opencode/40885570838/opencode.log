timestamp=2026-10-29T13:56:37.586Z level=INFO run=4e7c8391 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json\ntry:\n    d=json.load(open('/tmp/sdc.json'))\nexcept Exception as e:\n    print('err',e); raise SystemExit\nsubs=sorted({x.lower().strip() for x in d if x.lower().endswith('.sptpub.com')})\nprint('total',len(subs))\nwith open('result/inventory/subdomains.txt','w') as f:\n    for s in subs: f.write(s+'\\n')\nimport re,collections\ncats=collections.Counter()\ninteresting=[]\nfor s in subs:\n    lbl=s[:-len('.sptpub.com')]\n    if lbl.startswith('api-'): cats['api-*']+=1\n    elif lbl.startswith('www.'): cats['www.*']+=1\n    elif any(k in lbl for k in ['admin','back','office','cms','manage','partner','affiliate','promo','bonus','pay','cash','wallet','kyc','doc','upload','file','static','theme','help','wiki','docs','swagger','graphql','ws','mail','smtp','vpn','git','jenkins','grafana','kibana','monitor','status','cdn','img','asset','dev','stage','test','beta','uat','qa','demo','sandbox','internal','intranet']):\n        interesting.append(s)\n    else: cats['other/brand']+=1\nprint(cats)\nprint('--- interesting ---')\nfor s in interesting: print(s)\nPY" action.permission=* action.action=allow action.pattern=*
