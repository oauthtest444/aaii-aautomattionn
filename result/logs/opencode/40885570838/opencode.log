timestamp=2026-10-29T13:56:49.276Z level=INFO run=4e7c8391 message=evaluated permission=bash pattern="python3 - <<'PY' > /tmp/probe2.txt\nimport socket, urllib.request, urllib.error, concurrent.futures\nhosts=['api1-ws.sptpub.com','help-beta-ingress.sptpub.com','help-beta.sptpub.com','help-betag.sptpub.com','files-immutable-4cbc033nbd3bc.sptpub.com','files-immutable-4cbc033nbd3s.sptpub.com','www.static.sptpub.com','777pub.sptpub.com','1goodbet.sptpub.com','bet7k9.sptpub.com','betler.sptpub.com','start26.sptpub.com','api-h-8b6b4210-1006q.sptpub.com','api-a-c34e8269-1333c.sptpub.com','api-k-dfe49a3e-680.sptpub.com','api-y-089t2gyhf4-7756u.sptpub.com']\ndef probe(h):\n    o={'host':h}\n    try: o['ip']=socket.gethostbyname(h)\n    except Exception as e: o['dns']='fail'; return o\n    try:\n        req=urllib.request.Request(f'https://{h}/',headers={'User-Agent':'Mozilla/5.0'})\n        r=urllib.request.urlopen(req,timeout=15)\n        o.update(status=r.status,server=r.headers.get('server'),ct=r.headers.get('content-type'),loc=r.headers.get('location'),xcache=r.headers.get('x-cache'))\n    except urllib.error.HTTPError as e:\n        o.update(status=e.code,server=e.headers.get('server'),ct=e.headers.get('content-type'),loc=e.headers.get('location'),xcache=e.headers.get('x-cache'))\n    except Exception as e:\n        o['err']=type(e).__name__\n    return o\nwith concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:\n    for o in ex.map(probe,hosts): print(o)\nPY" action.permission=* action.action=allow action.pattern=*
