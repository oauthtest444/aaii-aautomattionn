timestamp=2026-10-29T14:04:11.771Z level=INFO run=4e7c8391 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport urllib.request, urllib.parse, xml.etree.ElementTree as ET, json\nns='{http://s3.amazonaws.com/doc/2006-03-01/}'\ndef fetch(host, params=''):\n    url=f'https://{host}/{params}'\n    r=urllib.request.urlopen(url,timeout=30)\n    return r, ET.fromstring(r.read())\n# static first page via in-scope host\nr,root=fetch('static.sptpub.com')\nkeys=[]\nfor c in root.findall(ns+'Contents'):\n    keys.append((c.findtext(ns+'Key'),c.findtext(ns+'Size'),c.findtext(ns+'LastModified')))\nwith open('result/server-side/static.sptpub.com/traffic/bucket-listing-first1000.tsv','w') as f:\n    f.write('# fetched '+__import__('datetime').datetime.utcnow().isoformat()+'Z via https://static.sptpub.com/\\n')\n    f.write('key\\tsize\\tlast_modified\\n')\n    for k,s,lm in keys: f.write(f'{k}\\t{s}\\t{lm}\\n')\nprint('static objects first page:',len(keys))\n# files-immutable prefixes via direct S3 list API\nbase='https://spt77-nondynamic-files.s3.eu-central-1.amazonaws.com/'\nroot=ET.fromstring(urllib.request.urlopen(base+'?list-type=2&delimiter=%2F&max-keys=1000',timeout=30).read())\nprefs=[p.findtext(ns+'Prefix') for p in root.findall(ns+'CommonPrefixes')]\nwith open('result/server-side/files-immutable-4cbc033nbd3.sptpub.com/traffic/bucket-prefixes.txt','w') as f:\n    f.write('# fetched via in-scope host https://files-immutable-4cbc033nbd3.sptpub.com/ and S3 list API (read-only)\\n')\n    for p in prefs: f.write(p+'\\n')\nprint('prefixes',prefs)\n# counts per prefix\ncounts={}\nfor pref in prefs:\n    keys=[]; token=None\n    while True:\n        params={'list-type':'2','prefix':pref,'max-keys':'1000'}\n        if token: params['continuation-token']=token\n        rr=ET.fromstring(urllib.request.urlopen(base+'?'+urllib.parse.urlencode(params),timeout=30).read())\n        keys += [c.findtext(ns+'Key') for c in rr.findall(ns+'Contents')]\n        t=rr.findtext(ns+'NextContinuationToken')\n        if rr.findtext(ns+'IsTruncated')!='true' or not t: break\n        token=t\n    counts[pref]=len(keys)\nwith open('result/server-side/files-immutable-4cbc033nbd3.sptpub.com/traffic/key-counts.json','w') as f:\n    json.dump(counts,f,indent=1)\nprint(counts)\n# sample of translations keys only\nPY" action.permission=* action.action=allow action.pattern=*
