timestamp=2026-10-29T14:10:45.285Z level=INFO run=4e7c8391 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport subprocess, concurrent.futures, random, string\nhosts=[l.strip() for l in open('result/inventory/subdomains.txt') if l.strip()]\ndef run(args):\n    for _ in range(2):\n        try:\n            return subprocess.run(args,capture_output=True,text=True,timeout=10).stdout.strip()\n        except Exception: pass\n    return ''\ndef cn(h):\n    out=run(['dig','+noall','+answer','CNAME',h])\n    lines=[l for l in out.splitlines() if '\\tCNAME\\t' in l or ' CNAME ' in l]\n    if not lines: return h,[]\n    return h,[l.split()[-1].rstrip('.') for l in lines]\ncnames={}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=25) as ex:\n    for h,c in ex.map(cn,hosts):\n        if c: cnames[h]=c\ntargets=sorted({t for v in cnames.values() for t in v})\ndef addr(t):\n    out=run(['dig','+short','A',t])\n    return t, bool(out.strip()), out.split()[:2]\nstatus={}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=25) as ex:\n    for t,ok,a in ex.map(addr,targets): status[t]=(ok,a)\nprint('hosts with cname',len(cnames),'targets',len(targets))\ndangling=[t for t,(ok,a) in status.items() if not ok]\nprint('DANGLING TARGETS',len(dangling))\nfor t in dangling: print('  ',t)\nprint('\\nHOSTS -> DANGLING:')\nfor h,v in sorted(cnames.items()):\n    if any(not status[t][0] for t in v): print('  ',h,'->',v)\nprint('\\nall cnames:')\nfor h,v in sorted(cnames.items()): print(h,'->',', '.join(v))\nwith open('result/logs/dns-cnames.txt','w') as f:\n    for h,v in sorted(cnames.items()): f.write(h+'\\t'+', '.join(v)+'\\n')\nprint('\\nwildcard test:', run(['dig','+short','A','zzq'+''.join(random.choices(string.ascii_lowercase,k=10))+'.sptpub.com']) or 'NXDOMAIN')\nPY" action.permission=* action.action=allow action.pattern=*
