timestamp=2026-10-29T13:54:35.438Z level=INFO run=4e7c8391 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport re\nsubs=set()\ntry:\n    for line in open('/tmp/ht.txt'):\n        if ',' in line:\n            subs.add(line.split(',')[0].strip().lower())\nexcept Exception as e: print('ht err',e)\ntry:\n    html=open('/tmp/rd.html',errors='ignore').read()\n    for m in re.findall(r'[a-zA-Z0-9._-]+\\.sptpub\\.com', html):\n        subs.add(m.lower())\nexcept Exception as e: print('rd err',e)\nsubs={s for s in subs if s.endswith('.sptpub.com') and '*' not in s}\nprint('total unique',len(subs))\nwith open('result/inventory/subdomains.txt','w') as f:\n    for s in sorted(subs): f.write(s+'\\n')\nfor s in sorted(subs): print(s)\nPY" action.permission=* action.action=allow action.pattern=*
