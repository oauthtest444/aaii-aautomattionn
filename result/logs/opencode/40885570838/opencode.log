timestamp=2026-10-29T13:53:27.292Z level=INFO run=4e7c8391 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json, urllib.request\nnames='''www app api admin portal login dashboard mail blog dev staging stage test beta cdn static docs help wiki support m shop store cloud console account auth sso vpn secure my web site gateway edge origin files download upload images img assets status monitor analytics grafana kibana jenkins git gitlab ci registry docker internal intranet hr finance erp crm helpdesk ticket tickets news media video chat live play game sandbox demo preview release prod production uat qa lb proxy cache search embed widget partner affiliate pay payment billing invoice order orders user users customer member members spt pub forum community blog2 store2 career jobs\n'''.split()\nseen=set()\ndef q(name,typ='A'):\n    url=f'https://cloudflare-dns.com/dns-query?name={name}&type={typ}'\n    req=urllib.request.Request(url,headers={'accept':'application/dns-json'})\n    try:\n        d=json.load(urllib.request.urlopen(req,timeout=8))\n        return d.get('Answer',[])\n    except Exception:\n        return []\nfor n in names:\n    if n in seen: continue\n    seen.add(n)\n    fq=f'{n}.sptpub.com'\n    a=q(fq)\n    if a:\n        print(fq, [(x.get('type'),x.get('data')) for x in a])\nPY" action.permission=* action.action=allow action.pattern=*
