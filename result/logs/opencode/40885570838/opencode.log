ss blocked\"} for all tested paths/headers'},\n  {'method':'GET','path':'/','host':'bettilt.sptpub.com','auth':'none','variants':['root','/login','/robots.txt','/api/'],'status':'unresolved','notes':'CloudFront returns 403 {\"error\":\"access blocked\"} for all tested paths/headers'}\n ],\n 'listeners':[]\n}\njson.dump(inv,open('result/testing-inventory.json','w'),indent=2)\nprint('routes',len(routes))\nPY" action.permission=* action.action=allow action.pattern=*
