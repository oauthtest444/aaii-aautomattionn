timestamp=2026-10-29T13:57:56.846Z level=INFO run=4e7c8391 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport urllib.request, urllib.parse, xml.etree.ElementTree as ET, collections\nns='{http://s3.amazonaws.com/doc/2006-03-01/}'\nbase='https://spt77-nondynamic-files.s3.eu-central-1.amazonaws.com/'\ndef listall(prefix):\n    keys=[]; token=None\n    while True:\n        p={'list-type':'2','prefix':prefix,'max-keys':'1000'}\n        if token: p['continuation-token']=token\n        r=ET.fromstring(urllib.request.urlopen(base+'?'+urllib.parse.urlencode(p),timeout=30).read())\n        for c in r.findall(ns+'Contents'):\n            keys.append((c.findtext(ns+'Key'), int(c.findtext(ns+'Size') or 0)))\n        t=r.findtext(ns+'NextContinuationToken')\n        if r.findtext(ns+'IsTruncated')!='true' or not t: break\n        token=t\n    return keys\nallk=[]\nfor pref in ['currencies/','flags_by_code/','rocket-league/','translations/']:\n    ks=listall(pref); allk+=ks\n    print(f'== {pref} count={len(ks)}')\n    for k,s in ks[:20]: print('   ',s,k)\n    if len(ks)>20: print('    ...')\n# extension summary\next=collections.Counter()\nfor k,s in allk:\n    ext[k.rsplit('.',1)[-1].lower() if '.' in k.split('/')[-1] else '(none)']+=1\nprint('extensions:',ext.most_common(20))\nimport json\njson.dump(allk,open('/tmp/nondynamic_keys.json','w'))\nPY" action.permission=* action.action=allow action.pattern=*
