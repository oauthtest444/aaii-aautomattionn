pat=re.compile(r'addEventListener\(\s*[\'"]message[\'"]\s*,')
for fn in os.listdir('js'):
    u=h2u.get(fn)
    if not u or '/bp-fe/' not in u: continue
    p='js/'+fn
    try:
        if os.path.getsize(p)>8_000_000: continue
        s=open(p,encoding='utf-8',errors='replace').read()
