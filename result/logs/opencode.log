import re,glob,os
patterns={
 'source_searchParams': re.compile(r'searchParams\.get\([^)]*\)|\.get\(("([^"]*)"|\'([^\']*)\'|`([^`]*)`)\)'),
 'source_new_URL': re.compile(r'(?<![=!<>])(?:\b[A-Za-z_$][\w$]*\s*=\s*)new\s+(?:URLSearchParams|URL)\s*\(\s*(?:(?:window\.)?location\.(?:search|href|hash|pathname)|document\.(?:URL|URLUnencoded|baseURI))\b'),
 'sink_loc_assign': re.compile(r'(?:window\.)?location\.(?:assign|replace)\s*\(\s*(?![`\'"]|\$\{|window\.location\.|location\.|\w+\.href)'),
 'sink_loc_href': re.compile(r'(?<![\w$.])(?:window\.|document\.|parent\.|top\.|self\.|frames\[\d+\]\.)?location(?:\.href)?\s*=\s*(?!=)\s*(?![\w$]+(?:\.[\w$]+)*\.href\b)(?![\w$]+(?:\.[\w$]+)*\.toString\(\))(?![`\'"]|`\/|""\.concat|null\b|\{)(?!\(null\s*==[\s\S]*?this\.location[\s\S]*?\.toString\(\))(?!\(0\s*,\s*[\w$]+\.[\w$]+\)\s*\()'),
 'sink_createElement': re.compile(r'document\.createElement\(([\'"])(iframe|object|embed|script)\1\);?'),
 'sink_html_eval': re.compile(r'(\beval\s*\(\s*(?![`\'"])|new\s+Function\s*\(\s*(?![`\'"])|document\.write\s*\(|insertAdjacentHTML\s*\()|\.(?:inner|outer)HTML\b\s*=\s*(?!=)(?!\s*(?:[`\'"]|null\b|\w+\.(?:inner|outer)HTML))|\.srcdoc\b\s*=\s*(?!=)(?!\s*(?:[`\'"]|null\b))'),
 'sink_dangerous': re.compile(r'dangerouslySetInnerHTML\s*=\s*\{\{|dangerouslySetInnerHTML\s*[:=]\s*\{'),
}
for name,rx in patterns.items():
    print('\n====',name)
    total=0
    for fn in sorted(glob.glob('*.js')):
        s=open(fn,encoding='utf-8',errors='ignore').read()
        ms=list(rx.finditer(s))
        if ms:
            total+=len(ms)
            for m in ms[:6]:
                a=max(0,m.start()-60); b=min(len(s),m.end()+60)
                print(f'{fn}:{m.start()} :: '+s[a:b].replace('\n',' '))
            if len(ms)>6: print(f'  ... {len(ms)-6} more in {fn}')
    print('TOTAL',total)
