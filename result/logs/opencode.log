pats={
 'finance_paths': r'/finance/[A-Za-z0-9_/?=&.\-]+',
 'api_paths': r'/api/[A-Za-z0-9_/?=&.\-]+',
 'route_paths': r'path:"([^"]+)"',
}
for name,pat in pats.items():
    vals=set()
    for f in glob.glob('*.js'):
        s=open(f,encoding='utf-8',errors='ignore').read()
        for m in re.findall(pat,s):
            vals.add(m)
    print('===',name,len(vals))
    for v in sorted(vals)[:120]: print(v)
