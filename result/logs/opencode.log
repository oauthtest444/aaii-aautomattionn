names='''www app api admin portal login dashboard mail blog dev staging stage test beta cdn static docs help wiki support m shop store cloud console account auth sso vpn secure my web site gateway edge origin files download upload images img assets status monitor analytics grafana kibana jenkins git gitlab ci registry docker internal intranet hr finance erp crm helpdesk ticket tickets news media video chat live play game sandbox demo preview release prod production uat qa lb proxy cache search embed widget partner affiliate pay payment billing invoice order orders user users customer member members spt pub forum community blog2 store2 career jobs
'''.split()
seen=set()
def q(name,typ='A'):
    url=f'https://cloudflare-dns.com/dns-query?name={name}&type={typ}'
    req=urllib.request.Request(url,headers={'accept':'application/dns-json'})
    try:
        d=json.load(urllib.request.urlopen(req,timeout=8))
        return d.get('Answer',[])
    except Exception:
