import re,glob
for f in glob.glob('*.js'):
    s=open(f,encoding='utf-8',errors='ignore').read()
    for m in re.finditer(r'OB:function\(\)\{return ([A-Za-z0-9_$]+)\}', s):
        # find enclosing module id
        mm=list(re.finditer(r'[,{](\d{2,6}):function\(', s[:m.start()]))
        mid=mm[-1].group(1) if mm else '?'
        print(f, "module", mid, "OB->", m.group(1))
