from PIL import Image
import numpy as np
bg=np.array(Image.open('/tmp/bg2').convert('L')).astype(float)
pc=np.array(Image.open('/tmp/pc2').convert('RGBA')).astype(float)
alpha=pc[:,:,3]; mask=alpha>200
ys,xs=np.where(mask); y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1
pl=pc[:,:,0]
def grad(a):
  gx=np.zeros_like(a); gy=np.zeros_like(a)
  gx[:,1:-1]=a[:,2:]-a[:,:-2]; gy[1:-1,:]=a[2:,:]-a[:-2,:]
  return np.sqrt(gx*gx+gy*gy)
gpb=grad(bg); gpp=grad(pl)
pt=gpp[y0:y1,x0:x1]; pm=mask[y0:y1,x0:x1]
h,w=pt.shape
# normalize
ptn=(pt-pt[pm].mean())/(pt[pm].std()+1e-6)
best=None
for oy in range(0,bg.shape[0]-h+1):
  for ox in range(0,bg.shape[1]-w+1):
    reg=gpb[oy:oy+h,ox:ox+w]
    rv=reg[pm]
    rn=(rv-rv.mean())/(rv.std()+1e-6)
    score=(rn*ptn[pm]).mean()
    if best is None or score>best[0]: best=(score,ox,oy)
print('edge best',best)
d,ox,oy=best
disp_target_left = 220 + ox/552*340
disp_piece_left = 220 + x0/110*67.75
print('dx',disp_target_left-disp_piece_left)
