[0m$ [0mpython3 - <<'PY'
import subprocess, concurrent.futures, random, string
hosts=[l.strip() for l in open('result/inventory/subdomains.txt') if l.strip()]
def run(args):
    for _ in range(2):
        try:
            return subprocess.run(args,capture_output=True,text=True,timeout=10).stdout.strip()
        except Exception: pass
    return ''
def cn(h):
    out=run(['dig','+noall','+answer','CNAME',h])
    lines=[l for l in out.splitlines() if '\tCNAME\t' in l or ' CNAME ' in l]
    if not lines: return h,[]
    return h,[l.split()[-1].rstrip('.') for l in lines]
cnames={}
with concurrent.futures.ThreadPoolExecutor(max_workers=25) as ex:
    for h,c in ex.map(cn,hosts):
        if c: cnames[h]=c
targets=sorted({t for v in cnames.values() for t in v})
def addr(t):
    out=run(['dig','+short','A',t])
    return t, bool(out.strip()), out.split()[:2]
status={}
with concurrent.futures.ThreadPoolExecutor(max_workers=25) as ex:
    for t,ok,a in ex.map(addr,targets): status[t]=(ok,a)
print('hosts with cname',len(cnames),'targets',len(targets))
dangling=[t for t,(ok,a) in status.items() if not ok]
print('DANGLING TARGETS',len(dangling))
for t in dangling: print('  ',t)
print('\nHOSTS -> DANGLING:')
for h,v in sorted(cnames.items()):
    if any(not status[t][0] for t in v): print('  ',h,'->',v)
print('\nall cnames:')
for h,v in sorted(cnames.items()): print(h,'->',', '.join(v))
with open('result/logs/dns-cnames.txt','w') as f:
    for h,v in sorted(cnames.items()): f.write(h+'\t'+', '.join(v)+'\n')
print('\nwildcard test:', run(['dig','+short','A','zzq'+''.join(random.choices(string.ascii_lowercase,k=10))+'.sptpub.com']) or 'NXDOMAIN')
