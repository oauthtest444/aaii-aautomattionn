[0m$ [0mcd /tmp/bp && python3 - <<'PY'
import re,collections,os
# parse scan_sink blocks
blocks=open('scan_sink.txt',encoding='utf-8',errors='replace').read().split('==== ')[1:]
info=collections.defaultdict(lambda: collections.Counter())
urls={}
for b in blocks:
    first=b.split('\n',1)[0]
    parts=first.split(' ::')
    fn=parts[0].strip(); u=parts[1].strip() if len(parts)>1 else ''
    urls[fn]=u
    srcs=re.findall(r'\.get\(\s*["\']([^"\']{1,40})["\']\s*\)',b)
    for s in srcs: info[fn][s]+=1
for fn,c in sorted(info.items(), key=lambda x:-sum(x[1].values())):
    u=urls.get(fn,'')
    print(fn, sum(c.values()), u[:120])
    print('   ', ', '.join(f'{k}({v})' for k,v in c.most_common(12)))
