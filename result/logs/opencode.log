import urllib.request, urllib.parse, xml.etree.ElementTree as ET, json
ns='{http://s3.amazonaws.com/doc/2006-03-01/}'
def fetch(host, params=''):
    url=f'https://{host}/{params}'
    r=urllib.request.urlopen(url,timeout=30)
    return r, ET.fromstring(r.read())
# static first page via in-scope host
r,root=fetch('static.sptpub.com')
keys=[]
for c in root.findall(ns+'Contents'):
    keys.append((c.findtext(ns+'Key'),c.findtext(ns+'Size'),c.findtext(ns+'LastModified')))
with open('result/server-side/static.sptpub.com/traffic/bucket-listing-first1000.tsv','w') as f:
    f.write('# fetched '+__import__('datetime').datetime.utcnow().isoformat()+'Z via https://static.sptpub.com/\n')
    f.write('key\tsize\tlast_modified\n')
    for k,s,lm in keys: f.write(f'{k}\t{s}\t{lm}\n')
print('static objects first page:',len(keys))
# files-immutable prefixes via direct S3 list API
base='https://spt77-nondynamic-files.s3.eu-central-1.amazonaws.com/'
root=ET.fromstring(urllib.request.urlopen(base+'?list-type=2&delimiter=%2F&max-keys=1000',timeout=30).read())
prefs=[p.findtext(ns+'Prefix') for p in root.findall(ns+'CommonPrefixes')]
with open('result/server-side/files-immutable-4cbc033nbd3.sptpub.com/traffic/bucket-prefixes.txt','w') as f:
    f.write('# fetched via in-scope host https://files-immutable-4cbc033nbd3.sptpub.com/ and S3 list API (read-only)\n')
    for p in prefs: f.write(p+'\n')
print('prefixes',prefs)
# counts per prefix
counts={}
for pref in prefs:
    keys=[]; token=None
    while True:
        params={'list-type':'2','prefix':pref,'max-keys':'1000'}
        if token: params['continuation-token']=token
        rr=ET.fromstring(urllib.request.urlopen(base+'?'+urllib.parse.urlencode(params),timeout=30).read())
        keys += [c.findtext(ns+'Key') for c in rr.findall(ns+'Contents')]
        t=rr.findtext(ns+'NextContinuationToken')
        if rr.findtext(ns+'IsTruncated')!='true' or not t: break
        token=t
    counts[pref]=len(keys)
with open('result/server-side/files-immutable-4cbc033nbd3.sptpub.com/traffic/key-counts.json','w') as f:
    json.dump(counts,f,indent=1)
print(counts)
# sample of translations keys only
