import json,re
from urllib.parse import urlsplit
d=json.load(open('crawl.json'))
def norm(u):
    try:
        s=urlsplit(u)
    except: return None
    if s.netloc!='console.byteplus.com': return None
    p=s.path
    if not p.startswith('/api/'): return None
    p=re.sub(r'/ap-[a-z0-9-]+/','/{region}/',p)
    p=re.sub(r'/(cn|us|eu|sa|me|af)-[a-z0-9-]+/','/{region}/',p)
    return (s.netloc,p)
agg={}
for e in d:
    for a in e.get('apis',[]):
        n=norm(a.get('url',''))
        if not n: continue
        m=a.get('method') or 'GET'
        agg.setdefault((m,n[1]),set()).add(e['route'])
print('unique api endpoints',len(agg))
# routes.md
with open('/home/runner/work/aaii-aautomattionn/aaii-aautomattionn/result/inventory/routes.md','w') as f:
    f.write('# Route inventory — console.byteplus.com\n\n')
    f.write('Crawled %d routes (account A). Status = HTTP status of final document.\n\n'%len(d))
    f.write('| # | Route | Final URL | Status | Scripts | APIs | Links |\n')
    f.write('|---|-------|-----------|--------|---------|------|-------|\n')
    for i,e in enumerate(d,1):
        f.write('| %d | %s | %s | %s | %d | %d | %d |\n'%(i,e['route'],e['finalUrl'],e['status'],len(e.get('scripts',[])),len(e.get('apis',[])),len(e.get('links',[]))))
# endpoints.md
with open('/home/runner/work/aaii-aautomattionn/aaii-aautomattionn/result/inventory/endpoints.md','w') as f:
    f.write('# Endpoint inventory — console.byteplus.com\n\n')
    f.write('Unique same-origin `/api/...` endpoint shapes observed during the %d-route crawl (region segments normalized to `{region}`). %d unique method+path.\n\n'%(len(d),len(agg)))
    f.write('| Method | Path (normalized) | Routes observed |\n|--------|-------------------|------------------|\n')
    for (m,p),rs in sorted(agg.items(), key=lambda x:(x[0][1],x[0][0])):
        f.write('| %s | `%s` | %d |\n'%(m,p,len(rs)))
# dump raw map for json
json.dump({f'{m} {p}':sorted(rs) for (m,p),rs in agg.items()}, open('/tmp/bp2/endpoints_agg.json','w'), indent=0)
print('wrote routes.md, endpoints.md')
