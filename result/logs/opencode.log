import socket, ssl, urllib.request, concurrent.futures, json, time
hosts=[l.strip() for l in open('result/inventory/subdomains.txt') if l.strip()]
def probe(h):
    out={'host':h}
    try:
        out['ip']=socket.gethostbyname(h)
    except Exception as e:
        out['dns']='fail'; return out
    for scheme in ('https','http'):
        try:
            req=urllib.request.Request(f'{scheme}://{h}/',headers={'User-Agent':'Mozilla/5.0 (compatible; security-recon)'})
            r=urllib.request.urlopen(req,timeout=12)
            out[scheme]={'status':r.status,'url':r.geturl(),'server':r.headers.get('server'),'ct':r.headers.get('content-type'),'loc':r.headers.get('location'),'len':r.headers.get('content-length')}
            break
        except urllib.error.HTTPError as e:
            out[scheme]={'status':e.code,'server':e.headers.get('server'),'loc':e.headers.get('location'),'ct':e.headers.get('content-type')}
            break
        except Exception as e:
            out[scheme]='err:'+type(e).__name__
    return out
res=[]
with concurrent.futures.ThreadPoolExecutor(max_workers=12) as ex:
    for r in ex.map(probe,hosts):
        res.append(r)
json.dump(res,open('/tmp/probe.json','w'),indent=1)
for r in res:
    line=r['host']
    for s in ('https','http'):
        v=r.get(s)
        if isinstance(v,dict):
            line+=f" | {s}:{v.get('status')} srv={v.get('server')} loc={v.get('loc')} ct={v.get('ct')}"
            break
        elif v:
            line+=f" | {s}:{v}"
    print(line)
PY
