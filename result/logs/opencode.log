import re,os,hashlib
urls=[l.strip() for l in open('app_urls.txt') if l.strip()]
h2u={hashlib.sha256(u.encode()).hexdigest()[:16]+'.js':u for u in urls}
pat=re.compile(r'\.get\(\s*["\']([^"\']+)["\']\s*\)')
interesting=re.compile(r'url|uri|redirect|redir|return|next|target|link|jump|back|goto|to|dest|continue|callback|path|from',re.I)
for f in [l.strip() for l in open('app_files.txt') if l.strip()]:
    s=open(f,encoding='utf-8',errors='replace').read()
    for m in pat.finditer(s):
        name=m.group(1)
        if not interesting.search(name): continue
        a=max(0,m.start()-300); b=min(len(s),m.end()+400); ctx=s[a:b]
        if re.search(r'location|window\.open|redirect|assign|replace',ctx):
            print('====',os.path.basename(f),'::',h2u.get(os.path.basename(f)),'::',name)
            print(ctx.replace('\n',' '))
