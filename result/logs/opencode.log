import re,glob
for name in ['CommonBuy','CreatePay','AsyncCreateOrder','PreVerificationForOrder','GetInvoiceInfo','ListProductOrderDetails','GetBalanceByOrder','QueryInstance','ListPackageDetail','DownloadExclusiveAccountCertificate','ListTask','GetTask']:
    print('\n#####',name)
    hits=0
    for f in glob.glob('*.js'):
        s=open(f,encoding='utf-8',errors='replace').read()
        for m in re.finditer(name,s):
            i=m.start()
            seg=s[max(0,i-250):i+350]
            if 'url:' in seg or 'data:' in seg or 'Account' in seg or 'Payer' in seg:
                print('FILE',f); print(seg); print('---'); hits+=1
                if hits>=3: break
        if hits>=3: break
