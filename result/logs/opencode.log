=== workflow ===
name: Aaii Buug Bounnty Aautomaationn

on:
  workflow_dispatch:
    inputs:
      target:
        description: "Optional authorized target URL/domain for this manual run"
        required: false
        type: string
      resume:
        description: "Internal: preserve result/ and resume after an automatic restart"
        required: false
        default: "false"
        type: string
  schedule:
    - cron: "0 */6 * * *"

permissions:
  contents: write
  actions: write

concurrency:
  group: ai-bug-bounty-automation
  cancel-in-progress: false

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 355

    env:
      CHROME_DEBUG_PORT: "9222"
      CHROME_PROFILE_DIR: /tmp/chrome-mcp-profile
      CHROME_LOG_FILE: /tmp/chrome-mcp.log
      OPENCODE_MODEL: opencode/deepseek-v4.1-flash-free

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Restore cached Chrome package
        id: chrome-cache
        uses: actions/cache@v4
        with:
          path: ~/.cache/chrome-deb
          key: google-chrome-stable-deb-${{ runner.os }}-v1

      - name: Install headless Chrome
        run: |
          set -euo pipefail
          DEB="$HOME/.cache/chrome-deb/google-chrome-stable_current_amd64.deb"
          mkdir -p "$(dirname "$DEB")"
          if [ ! -s "$DEB" ]; then
            echo "Downloading Chrome package..."
            curl -fsSL -o "$DEB" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
          else
            echo "Using cached Chrome package."
          fi
          sudo apt-get update -qq
          if ! sudo apt-get install -y "$DEB"; then
            echo "Cached package failed; downloading a fresh copy..."
            rm -f "$DEB"
            curl -fsSL -o "$DEB" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
            sudo apt-get install -y "$DEB"
          fi
          google-chrome-stable --version

      - name: Install OpenCode (fresh each run)
        run: |
          set -euo pipefail
          curl -fsSL https://opencode.ai/install | bash
          echo "$HOME/.opencode/bin" >> "$GITHUB_PATH"
          "$HOME/.opencode/bin/opencode" --version

      - name: Verify free model access
        run: |
          set -euo pipefail
          timeout 180 opencode run \
            --model "$OPENCODE_MODEL" \
            --dir "$RUNNER_TEMP" \
            "Reply with exactly OK"

      - name: Prepare optional manual target
        if: github.event_name == 'workflow_dispatch' && inputs.target != ''
        env:
          TARGET_INPUT: ${{ inputs.target }}
        run: |
          set -euo pipefail
          printf '%s\n' "$TARGET_INPUT" > data/targets.txt
          echo "Manual target prepared for this run only."

      - name: Restore target for resumed run
        if: github.event_name == 'workflow_dispatch' && inputs.resume == 'true'
        env:
          TARGET_INPUT: ${{ inputs.target }}
        run: |
          set -euo pipefail
          if [ -n "${TARGET_INPUT:-}" ]; then
            echo "Manual target takes precedence over the resumed target."
            exit 0
          fi
          if [ -s result/logs/targets.used.txt ]; then
            cp result/logs/targets.used.txt data/targets.txt
            echo "Restored previous target for resumed run."
          fi

      - name: Prepare target state and results
        env:
          RESUME_RUN: ${{ inputs.resume }}
        run: |
          set -euo pipefail
          mkdir -p result/logs
          CURRENT_HASH="$(sha256sum data/targets.txt | awk '{print $1}')"
          PREVIOUS_HASH="$(cat result/logs/targets.sha256 2>/dev/null || true)"
          if [ "${RESUME_RUN:-}" = "true" ]; then
            DECISION="preserved"
            echo "Automatic resume; preserving previous results."
          elif [ -n "$PREVIOUS_HASH" ] && [ "$CURRENT_HASH" = "$PREVIOUS_HASH" ]; then
            DECISION="preserved"
            echo "Target unchanged; preserving previous results."
          else
            DECISION="reset"
            echo "Target changed or no prior target state; starting fresh."
            find result -mindepth 1 -maxdepth 1 ! -name '.gitkeep' -exec rm -rf {} +
          fi
          mkdir -p result/client-side result/server-side result/findings result/inventory result/logs
          if [ ! -f result/confirmed-vuln.txt ]; then
            cat > result/confirmed-vuln.txt <<'EOF'
          # Confirmed vulnerabilities only.
          # Do not add speculative issues, status codes, reflected strings, or accepted-but-inert fields.
          # Entry format: see skills/AGENT.md, Section 9.
          EOF
          fi
          printf '%s\n' "$CURRENT_HASH" > result/logs/targets.sha256
          cp data/targets.txt result/logs/targets.used.txt
          {
            echo "run_id=${GITHUB_RUN_ID:-local}"
            echo "event=${GITHUB_EVENT_NAME:-local}"
            echo "timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            echo "target_hash=$CURRENT_HASH"
            echo "previous_hash=${PREVIOUS_HASH:-none}"
            echo "decision=$DECISION"
            echo "---"
          } >> result/logs/target-state.txt

      - name: Detect notification test
        id: notification_test
        if: github.event_name == 'workflow_dispatch'
        run: |
          set -euo pipefail
          if grep -qiE '^[[:space:]]*(TEST_NOTIFICATION[[:space:]]*[:=][[:space:]]*true|MODE[[:space:]]*[:=][[:space:]]*notification-test)[[:space:]]*$' data/targets.txt 2>/dev/null; then
            echo "test_mode=true" >> "$GITHUB_OUTPUT"
            echo "Notification test mode enabled; no target will be tested."
          else
            echo "test_mode=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Create notification test marker
        if: steps.notification_test.outputs.test_mode == 'true'
        run: |
          set -euo pipefail
          cat > result/TEST-NOTIFICATION.md <<'EOF'
          # Automation notification test

          - Status: TEST ONLY
          - Target tested: none
          - Confirmed vulnerabilities: none
          - Purpose: verify the workflow and Discord notification path

          This run intentionally did not test any target and did not create a
          confirmed vulnerability.
          EOF
          echo "Created result/TEST-NOTIFICATION.md"

      - name: Start Chrome MCP and run agent
        if: steps.notification_test.outputs.test_mode != 'true'
        timeout-minutes: 340
        env:
          AGENT_IDLE_TIMEOUT_SECONDS: "120"
          AGENT_MAX_ATTEMPTS: "3"
          AGENT_MAX_RECOVERIES: "1"
        run: |
          set -euo pipefail
          bash tools/chrome-mcp-start.sh

          BASE_CMD="$(cat tools/cmd.txt)"
          MODEL="$(awk '{for (i=1;i<=NF;i++) if ($i=="--model") {print $(i+1); exit}}' tools/cmd.txt)"
          RESUME_PROMPT='The previous attempt stalled. Read skills/AGENT.md and result/ inventory, then continue the authorized scan. Do not repeat completed work. Checkpoint confirmed findings immediately and continue with all remaining routes.'
          if [ -n "$MODEL" ]; then
            RESUME_CMD="opencode run --continue --model $MODEL '$RESUME_PROMPT'"
            FRESH_CMD="opencode run --model $MODEL '$RESUME_PROMPT'"
          else
            RESUME_CMD="opencode run --continue '$RESUME_PROMPT'"
