import urllib.request, urllib.parse, xml.etree.ElementTree as ET, collections
ns='{http://s3.amazonaws.com/doc/2006-03-01/}'
base='https://spt77-nondynamic-files.s3.eu-central-1.amazonaws.com/'
def listall(prefix):
    keys=[]; token=None
    while True:
        p={'list-type':'2','prefix':prefix,'max-keys':'1000'}
        if token: p['continuation-token']=token
        r=ET.fromstring(urllib.request.urlopen(base+'?'+urllib.parse.urlencode(p),timeout=30).read())
        for c in r.findall(ns+'Contents'):
            keys.append((c.findtext(ns+'Key'), int(c.findtext(ns+'Size') or 0)))
        t=r.findtext(ns+'NextContinuationToken')
        if r.findtext(ns+'IsTruncated')!='true' or not t: break
        token=t
    return keys
allk=[]
for pref in ['currencies/','flags_by_code/','rocket-league/','translations/']:
    ks=listall(pref); allk+=ks
    print(f'== {pref} count={len(ks)}')
    for k,s in ks[:20]: print('   ',s,k)
    if len(ks)>20: print('    ...')
# extension summary
ext=collections.Counter()
for k,s in allk:
    ext[k.rsplit('.',1)[-1].lower() if '.' in k.split('/')[-1] else '(none)']+=1
print('extensions:',ext.most_common(20))
import json
json.dump(allk,open('/tmp/nondynamic_keys.json','w'))
