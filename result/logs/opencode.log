[0m$ [0mcat > /tmp/opencode/scan.py <<'PY'
import os,re,json,sys
base='/tmp/opencode/js_cache'
urls={}
for line in open('/tmp/opencode/jslist.txt'):
    n,u=line.strip().split('|',1)
    urls[int(n)]=u
def ctx(hitpos,text,w=220):
    return text[max(0,hitpos-w):hitpos+w].replace('\n',' ')
# source markers
srcpat=re.compile(r'location\.(?:search|hash)|URLSearchParams|searchParams\.get|document\.referrer')
sinkpat=re.compile(r'dangerouslySetInnerHTML|innerHTML\s*=|outerHTML\s*=|insertAdjacentHTML|document\.write|\.srcdoc\s*=|\beval\s*\(|new\s+Function\s*\(')
hits=[]
for f in sorted(os.listdir(base)):
    if not f.endswith('.js'): continue
    n=int(f.split('_',1)[0])
    try: t=open(os.path.join(base,f),encoding='utf-8',errors='ignore').read()
    except: continue
    # window scan: for each sink, check source within 600 chars
    for m in sinkpat.finditer(t):
        s=max(0,m.start()-700); e=min(len(t),m.end()+700)
        win=t[s:e]
        if srcpat.search(win):
            hits.append({'file':f,'url':urls.get(n,''),'kind':m.group(0)[:40],'ctx':ctx(m.start(),t,350)})
    # postMessage listeners lacking origin check in window
    for m in re.finditer(r'addEventListener\(\s*["\']message["\']',t):
        s=m.start(); e=min(len(t),m.end()+900)
        win=t[s:e]
        if 'origin' not in win[:700]:
            hits.append({'file':f,'url':urls.get(n,''),'kind':'message-listener-no-origin-near','ctx':ctx(m.start(),t,400)})
print("HITS",len(hits))
seen=set()
for h in hits:
    k=(h['url'],h['kind'],h['ctx'][:80])
    if k in seen: continue
    seen.add(k)
    print('\n###',h['kind'],'\nURL:',h['url'],'\n',h['ctx'][:900])
