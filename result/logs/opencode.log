    <script type="module">
      (async () => {
        const brandId    = "2599624589818605571";
        let token        = null;
        const lang       = "tr";
        const depositUrl = null;
        const theme      = String("DARK").toLowerCase();
        const operatorPage = null;
        let themeName
        const storage   = sessionStorage;
        const TOKEN_KEY = "token";
        const getToken  = (key) => storage.getItem(key);
        const setToken  = (val) => storage.setItem(TOKEN_KEY, val);

        if ('BroadcastChannel' in window) {
          const channel = new BroadcastChannel("token-sync");

          const waitForToken = ({ timeout = 150 } = {}) =>
            new Promise((resolve, reject) => {
              const timer = setTimeout(() => {
                cleanup();
                reject(new Error("Timed out waiting for NEW_TOKEN"));
              }, timeout);

              const onMessage = (ev) => {
                const { type, token, brand_id } = ev.data || {};
                if (type === "NEW_TOKEN" && token && brand_id === brandId) {
                  cleanup();
                  resolve(token);
                }
              };

              function cleanup() {
                clearTimeout(timer);
                channel.removeEventListener("message", onMessage);
              }

              channel.addEventListener("message", onMessage);
              channel.postMessage({ type: "REQUEST_TOKEN", brand_id: brandId });
            });

          channel.addEventListener("message", (e) => {
            const msg = e.data;
            if (!msg || typeof msg !== "object") return;

            // ignore if brand mismatch
            if (msg.brand_id && msg.brand_id !== brandId) return;

            if (msg.type === "REQUEST_TOKEN") {
              const have = getToken(TOKEN_KEY);
              if (have) channel.postMessage({ type: "NEW_TOKEN", token: have, brand_id: brandId });
            }

            if (msg.type === "NEW_TOKEN" && msg.token) {
              token = msg.token;
              setToken(token);
            }
          });

          
          if (token) {
            setToken(token);
            channel.postMessage({ type: "NEW_TOKEN", token, brand_id: brandId });
          } else {
            token = getToken(TOKEN_KEY) || "";
            if (!token) {
              try {
                token = await waitForToken({ timeout: 150 });
                setToken(token);
              } catch {
                token = "";
              }
            }
          }
        } else {
          if (token) {
            setToken(token);
            channel.postMessage({ type: "NEW_TOKEN", token, brand_id: brandId });
          } else {
            token = getToken(TOKEN_KEY) || "";
          }
        }

        

        if (theme === "light") {
          themeName = "demo-white-blue-classic"
          document.documentElement.style.background = "#fff"
        } else if (theme === "dark") {
          themeName = "default-table"
          document.documentElement.style.background = "rgb(18, 34, 43)"
        } else {
          themeName = theme
          document.documentElement.style.background = "rgb(18, 34, 43)"
        }

        const url = new URL(location.href);
        url.searchParams.delete("token");
        const sportsbookUrl = url.searchParams.get("url");
        url.searchParams.delete("url");
        history.replaceState({}, "", url);

        new BTRenderer().initialize({
          brand_id: brandId,
          token,
          lang,
          themeName,
          target: document.getElementById("app"),
          betSlipOffsetTop: 100,
          betslipZIndex: 999,
          stickyTop: 0,
          url: sportsbookUrl || "",
          onSessionRefresh() { window.location.reload(); },
          onBetSlipStateChange() {},
          onLogin() {
            if (operatorPage) window.location.href = operatorPage;
          },
          onRegister() {
            if (operatorPage) window.location.href = operatorPage;
          },
          onRecharge() {
            window.location.href = depositUrl ? depositUrl : operatorPage;
          },
          onTokenExpired() {
            return new Promise((resolve) => {
              const t = getToken(TOKEN_KEY);
              resolve(t);
            });
          }
        });
      })();
    </script>
