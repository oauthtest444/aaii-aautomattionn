import re,glob,collections
acts=collections.defaultdict(set)
for f in glob.glob('*.js'):
    s=open(f,encoding='utf-8',errors='replace').read()
    for m in re.finditer(r'/api/top/([a-z0-9_]+)/([a-z0-9\-]+)/([0-9\-]+)/([A-Za-z0-9_]+)',s):
        acts[m.group(4)].add((m.group(1),m.group(3)))
print('unique actions',len(acts))
for a in sorted(acts):
    svc=sorted(acts[a])
    print(a, svc[0][0], svc[0][1])
