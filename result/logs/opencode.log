[0m$ [0mcd /tmp && python3 - <<'PY'
import json
d=json.load(open('routes_apps.json'))
print("routes:",len(d))
from collections import Counter
c=Counter()
for x in d:
    if 'error' in x: print("ERR",x['route'],x['error']); continue
    names=[a['name'] for a in x.get('apps',[])]
    nfiles=sum(len(a.get('files') or []) for a in x.get('apps',[]))
    print(x['route'], x.get('status'), '->', x.get('finalUrl'), '| apps:', ','.join(names)[:120], '| files:', nfiles)
    for a in x.get('apps',[]):
        c[a['name']]+=1
print("=== unique apps ===")
for k,v in c.most_common(): print(v,k)
PY
