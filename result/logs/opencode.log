import re,os
# map hash->url for reporting
h2u={}
for u in open('crawl_scripts.txt'):
    u=u.strip()
    if not u: continue
    import hashlib
    h2u[hashlib.sha256(u.encode()).hexdigest()[:16]+'.js']=u
src=re.compile(r'\.get\(\s*["\']([^"\']{1,40})["\']\s*\)|location\.(?:search|hash|href)|document\.referrer|decodeURIComponent')
sink=re.compile(r'(?:innerHTML|outerHTML)\s*=(?!=)|insertAdjacentHTML\s*\(|dangerouslySetInnerHTML|document\.write(?:ln)?\s*\(|srcdoc\s*=(?!=)')
for fn in os.listdir('js'):
    u=h2u.get(fn)
    if not u or '/bp-fe/' not in u: continue
    p='js/'+fn
    try:
        if os.path.getsize(p)>8_000_000: continue
        s=open(p,encoding='utf-8',errors='replace').read()
    except: continue
    for m in sink.finditer(s):
        a=max(0,m.start()-900); b=min(len(s),m.end()+900); ctx=s[a:b]
        if src.search(ctx):
            print('====',fn,'::',u,'::SINK',m.group(0)[:40])
            print(ctx.replace('\n',' '))
PY
