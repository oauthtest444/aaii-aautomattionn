import urllib.request, xml.etree.ElementTree as ET, time
base='https://static.sptpub.com/'
ns='{http://s3.amazonaws.com/doc/2006-03-01/}'
marker=''
keys=[]
for _ in range(20):
    url=base+('?marker='+urllib.parse.quote(marker) if marker else '')
    data=urllib.request.urlopen(url,timeout=30).read()
    root=ET.fromstring(data)
    for c in root.findall(ns+'Contents'):
        k=c.findtext(ns+'Key'); s=c.findtext(ns+'Size'); lm=c.findtext(ns+'LastModified')
        keys.append((k,int(s or 0),lm))
    trunc=root.findtext(ns+'IsTruncated')
    if trunc!='true' or not keys: break
    marker=keys[-1][0]
print('total objects',len(keys))
import os
os.makedirs('result/server-side/static.sptpub.com/traffic',exist_ok=True)
with open('result/server-side/static.sptpub.com/traffic/bucket-listing.tsv','w') as f:
    for k,s,lm in keys:
        f.write(f'{k}\t{s}\t{lm}\n')
for k,s,lm in keys:
    print(f'{s:>10}  {k}')
