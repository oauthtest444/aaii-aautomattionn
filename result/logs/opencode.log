#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${CHROME_DEBUG_PORT:-9222}"
PROFILE="${CHROME_PROFILE_DIR:-/tmp/chrome-mcp-profile}"
LOG="${CHROME_LOG_FILE:-/tmp/chrome-mcp.log}"
MCP_URL="${CHROME_DEBUG_URL:-http://127.0.0.1:${PORT}}"

is_up() {
  curl -fsS --max-time 2 "${MCP_URL}/json/version" >/dev/null 2>&1
}

if ! is_up; then
  CHROME_BIN="${CHROME_BIN:-}"
  if [ -z "$CHROME_BIN" ]; then
    CHROME_BIN="$(command -v google-chrome-stable || command -v google-chrome || command -v chromium || command -v chromium-browser || true)"
  fi
  if [ -z "$CHROME_BIN" ]; then
    echo "ERROR: Chrome/Chromium binary not found" >&2
    exit 1
  fi

  mkdir -p "$PROFILE"
  nohup "$CHROME_BIN" \
    --headless=new \
    --no-sandbox \
    --disable-dev-shm-usage \
    --disable-gpu \
    --remote-debugging-address=127.0.0.1 \
    --remote-debugging-port="$PORT" \
    --user-data-dir="$PROFILE" \
    about:blank >"$LOG" 2>&1 &
fi

for _ in $(seq 1 30); do
  is_up && break
  sleep 1
done

if ! is_up; then
  echo "ERROR: Chrome DevTools not reachable at ${MCP_URL}" >&2
  tail -50 "$LOG" >&2 2>/dev/null || true
  exit 1
fi

python3 - "${REPO_ROOT}/opencode.json" "${MCP_URL}" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
url = sys.argv[2]
cfg = json.loads(path.read_text()) if path.exists() else {
    "$schema": "https://opencode.ai/config.json"
}
cfg.setdefault("$schema", "https://opencode.ai/config.json")
cfg.setdefault("autoupdate", False)
cfg.setdefault("permission", "allow")
cfg.setdefault("share", "disabled")
mcp = cfg.setdefault("mcp", {})
mcp["chrome-devtools"] = {
    "type": "local",
    "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        f"--browser-url={url}",
    ],
}
path.write_text(json.dumps(cfg, indent=2) + "\n")
PY

if ! opencode mcp list 2>/dev/null | grep -q "chrome-devtools.*connected"; then
  echo "ERROR: chrome-devtools MCP is not connected" >&2
  opencode mcp list 2>/dev/null || true
  exit 1
fi

echo "Chrome DevTools ready at ${MCP_URL}"
---
name: Aaii Buug Bounnty Aautomaationn

on:
  workflow_dispatch:
    inputs:
      target:
        description: "Optional authorized target URL/domain for this manual run"
        required: false
        type: string
      resume:
        description: "Internal: preserve result/ and resume after an automatic restart"
        required: false
        default: "false"
        type: string
  schedule:
    - cron: "0 */6 * * *"

permissions:
  contents: write
  actions: write

concurrency:
  group: ai-bug-bounty-automation
  cancel-in-progress: false

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 355

    env:
      CHROME_DEBUG_PORT: "9222"
      CHROME_PROFILE_DIR: /tmp/chrome-mcp-profile
      CHROME_LOG_FILE: /tmp/chrome-mcp.log
      OPENCODE_MODEL: opencode/deepseek-v4.1-flash-free

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Restore cached Chrome package
        id: chrome-cache
        uses: actions/cache@v4
        with:
          path: ~/.cache/chrome-deb
          key: google-chrome-stable-deb-${{ runner.os }}-v1

      - name: Install headless Chrome
        run: |
          set -euo pipefail
          DEB="$HOME/.cache/chrome-deb/google-chrome-stable_current_amd64.deb"
          mkdir -p "$(dirname "$DEB")"
          if [ ! -s "$DEB" ]; then
            echo "Downloading Chrome package..."
            curl -fsSL -o "$DEB" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
          else
            echo "Using cached Chrome package."
          fi
          sudo apt-get update -qq
          if ! sudo apt-get install -y "$DEB"; then
            echo "Cached package failed; downloading a fresh copy..."
            rm -f "$DEB"
            curl -fsSL -o "$DEB" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
            sudo apt-get install -y "$DEB"
          fi
          google-chrome-stable --version

      - name: Install OpenCode (fresh each run)
        run: |
          set -euo pipefail
          curl -fsSL https://opencode.ai/install | bash
          echo "$HOME/.opencode/bin" >> "$GITHUB_PATH"
          "$HOME/.opencode/bin/opencode" --version

      - name: Verify free model access
        run: |
          set -euo pipefail
          timeout 180 opencode run \
            --model "$OPENCODE_MODEL" \
            --dir "$RUNNER_TEMP" \
            "Reply with exactly OK"

      - name: Prepare optional manual target
        if: github.event_name == 'workflow_dispatch' && inputs.target != ''
        env:
          TARGET_INPUT: ${{ inputs.target }}
        run: |
          set -euo pipefail
          printf '%s\n' "$TARGET_INPUT" > data/targets.txt
          echo "Manual target prepared for this run only."

      - name: Restore target for resumed run
        if: github.event_name == 'workflow_dispatch' && inputs.resume == 'true'
