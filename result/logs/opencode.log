import re,glob,json,os,hashlib
urls=set()
byroute={}
for p in glob.glob('/tmp/bp/pages/*.html'):
    h=open(p,encoding='utf-8',errors='replace').read()
    h=h.replace('\\u002F','/').replace('\\/','/')
    found=set(re.findall(r'(?:(?:https?:)?//res\.gcloudcache\.com|/)[^\s"\'<>\\)]+?\.js(?:\?[^\s"\'<>\\)]*)?',h))
    # normalize protocol-relative
    norm=set()
    for u in found:
        if u.startswith('//'): u='https:'+u
        elif u.startswith('/'): u='https://console.byteplus.com'+u
        norm.add(u.split('?')[0])
    byroute[os.path.basename(p)[:-5]]=sorted(norm)
    urls|=norm
print('routes',len(byroute),'unique js',len(urls))
open('/tmp/bp/js_urls.txt','w').write('\n'.join(sorted(urls)))
json.dump(byroute,open('/tmp/bp/byroute.json','w'),indent=1)
PY
