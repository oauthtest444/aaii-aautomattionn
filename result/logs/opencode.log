import re,glob
pat=re.compile(r'"[A-Za-z]*(?:Auth|Authoriz|Author)[A-Za-z]*"\s*:\s*\{')
for f in glob.glob('*.js'):
    s=open(f,encoding='utf-8',errors='ignore').read()
    seen=set()
    for m in pat.finditer(s):
        k=m.group(0)
        if k in seen: continue
        seen.add(k)
        print(f, k)
