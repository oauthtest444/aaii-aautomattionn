from PIL import Image
import numpy as np
from scipy.signal import fftconvolve
bg=np.array(Image.open('/tmp/bg2').convert('L')).astype(float)
pc=np.array(Image.open('/tmp/pc2').convert('RGBA')).astype(float)
alpha=pc[:,:,3]; mask=alpha>200
ys,xs=np.where(mask); y0,y1,x0,x1=ys.min(),ys.max()+1,xs.min(),xs.max()+1
pl=pc[:,:,0]
def grad(a):
  gx=np.zeros_like(a); gy=np.zeros_like(a)
  gx[:,1:-1]=a[:,2:]-a[:,:-2]; gy[1:-1,:]=a[2:,:]-a[:-2,:]
  return np.sqrt(gx*gx+gy*gy)
ge=grad(bg); pe=grad(pl)[y0:y1,x0:x1]; pm=mask[y0:y1,x0:x1]
pe=np.where(pm,pe,0)
# zero-mean template
t=pe-pe[pm].mean(); t=np.where(pm,t,0)
corr=fftconvolve(ge,t[::-1,::-1],mode='valid')
# normalized by local std approx: use sqrt of local energy
ones=np.ones_like(t)
loc=fftconvolve(ge**2,ones[::-1,::-1],mode='valid')
norm=np.sqrt(np.maximum(loc,1e-6))
score=corr/norm
idx=np.unravel_index(np.argmax(score),score.shape)
print('fft best oy,ox',idx,'score',score[idx])
oy,ox=idx
disp_target_left = 220 + ox/552*340
disp_piece_left = 220 + x0/110*67.75
print('dx',disp_target_left-disp_piece_left)
