import json,re
d=json.load(open('crawl.json'))
from collections import defaultdict
api=defaultdict(lambda: {'routes':set(),'methods':set()})
for e in d:
    for a in e.get('apis',[]):
        u=a['url']
        p=u.split('?')[0]
        # normalize long ids-ish path segments? keep raw
        api[p]['routes'].add(e['route']); api[p]['methods'].add(a['method'])
print('unique api paths',len(api))
kw=re.compile(r'account|org|role|user|permission|tenant|owner|admin|create|update|delete|invite|share|key|token|policy|member|project|resource|order|invoice|bill',re.I)
rows=[(len(v['routes']),p,sorted(v['methods']),len(v['routes'])) for p,v in api.items() if kw.search(p)]
rows.sort(reverse=True)
for n,p,m,r in rows[:60]:
    print(m,p)
