python3 - <<'PY'
import re,glob
for f in glob.glob('*.js'):
    s=open(f,encoding='utf-8',errors='ignore').read()
    if any(x in s for x in ['srcdoc','external-frame','sanitize','DOMPurify']):
        print('###',f,len(s))
        for pat in ['srcdoc','external-frame','sanitize','DOMPurify','innerHTML','dangerouslySetInnerHTML','GetInMailInfo','Content']:
            ms=[m.start() for m in re.finditer(pat,s)]
            if ms:
                print(' ',pat,len(ms))
                for p in ms[:4]:
                    print('   ...',s[max(0,p-200):p+300].replace('\n',' '))
