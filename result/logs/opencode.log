                        console.log(`Value: "${entry.url}"`);
                    }
                });
            } catch(e) {}
        }
    }

    console.log(`Searching globally for: "${targetValue}"...`);
    search(window, 'window');
    console.log('Search complete.');
})('newfortestttt'); // <-- Put your target URL string here

