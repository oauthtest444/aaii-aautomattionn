import re,glob
names=set()
for f in glob.glob('*.js'):
    s=open(f,encoding='utf-8',errors='replace').read()
    for m in re.finditer(r'([A-Z][A-Za-z0-9_]{2,40}(?:Task|Export|Download|Report|Invoice|Instance|Package|Voucher|Coupon|Address|Email|Tag)[A-Za-z0-9_]*)',s):
        names.add(m.group(1))
for n in sorted(names):
    if any(k in n for k in ['Task','Export','Download','Report']): print(n)
