python3 - <<'PY'
import re,glob
terms=['ListPayerAndOwnerByBillOwnerID','SetBcUserProductSplitDimensionOpen','GetBcUserProductSplitDimensionOpen','ListOrder','ListOrderChannel','QueryDiscountPrice','ListWithdrawReservedProductConfigs','AddPaymentMethod','split-bill','/bill/detail','cost-analyse','invoice-manage']
for t in terms:
    print('\n########',t)
    for fn in sorted(glob.glob('*.js')):
        s=open(fn,encoding='utf-8',errors='ignore').read()
        idx=0; c=0
        while True:
            i=s.find(t,idx)
            if i<0 or c>=4: break
            print(f'--- {fn} @ {i} ---')
            print(s[max(0,i-350):i+350].replace('\n',' '))
            idx=i+1; c+=1
