import re,os,hashlib
urls=[l.strip() for l in open('app_urls.txt') if l.strip()]
h2u={hashlib.sha256(u.encode()).hexdigest()[:16]+'.js':u for u in urls}
src_pat=re.compile(r'\.get\(\s*["\']([^"\']{1,40})["\']\s*\)|location\.(?:search|hash|href|pathname)|document\.referrer|URLSearchParams')
sink_pat=re.compile(r'innerHTML\s*=|outerHTML\s*=|insertAdjacentHTML|document\.write(?:ln)?\s*\(|dangerouslySetInnerHTML|srcdoc\s*=|location(?:\.href)?\s*=|location\.(?:assign|replace)\s*\(|window\.open\s*\(|eval\s*\(|new\s+Function\s*\(')
for f in [l.strip() for l in open('app_files.txt') if l.strip()]:
    s=open(f,encoding='utf-8',errors='replace').read()
    for m in src_pat.finditer(s):
        a=max(0,m.start()-700); b=min(len(s),m.end()+1200); ctx=s[a:b]
        if sink_pat.search(ctx):
            print('====',os.path.basename(f),'::',h2u.get(os.path.basename(f)))
            print('SRC:',m.group(0)[:80])
            print(ctx.replace('\n',' '))
