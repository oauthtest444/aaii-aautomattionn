        has_origin = bool(re.search(r'\.origin|origin\s*===|origin\s*==|event\.source|\.source\s*===|isTrusted',ctx))
        print('====',fn,'::',u,'::origincheck=',has_origin)
        print(ctx.replace('\n',' '))
