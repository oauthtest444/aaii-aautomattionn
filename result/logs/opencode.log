          CURRENT_HASH="$(sha256sum data/targets.txt | awk '{print $1}')"
          PREVIOUS_HASH="$(cat result/logs/targets.sha256 2>/dev/null || true)"
          if [ "${RESUME_RUN:-}" = "true" ]; then
            DECISION="preserved"
            echo "Automatic resume; preserving previous results."
          elif [ -n "$PREVIOUS_HASH" ] && [ "$CURRENT_HASH" = "$PREVIOUS_HASH" ]; then
            DECISION="preserved"
            echo "Target unchanged; preserving previous results."
          else
            DECISION="reset"
            echo "Target changed or no prior target state; starting fresh."
            find result -mindepth 1 -maxdepth 1 ! -name '.gitkeep' -exec rm -rf {} +
          fi
          mkdir -p result/client-side result/server-side result/findings result/inventory result/logs
          if [ ! -f result/confirmed-vuln.txt ]; then
            cat > result/confirmed-vuln.txt <<'EOF'
          # Confirmed vulnerabilities only.
          # Do not add speculative issues, status codes, reflected strings, or accepted-but-inert fields.
          # Entry format: see skills/AGENT.md, Section 9.
          EOF
          fi
          printf '%s\n' "$CURRENT_HASH" > result/logs/targets.sha256
          cp data/targets.txt result/logs/targets.used.txt
          {
            echo "run_id=${GITHUB_RUN_ID:-local}"
            echo "event=${GITHUB_EVENT_NAME:-local}"
            echo "timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            echo "target_hash=$CURRENT_HASH"
            echo "previous_hash=${PREVIOUS_HASH:-none}"
            echo "decision=$DECISION"
            echo "---"
          } >> result/logs/target-state.txt

      - name: Detect notification test
        id: notification_test
        if: github.event_name == 'workflow_dispatch'
        run: |
          set -euo pipefail
          if grep -qiE '^[[:space:]]*(TEST_NOTIFICATION[[:space:]]*[:=][[:space:]]*true|MODE[[:space:]]*[:=][[:space:]]*notification-test)[[:space:]]*$' data/targets.txt 2>/dev/null; then
            echo "test_mode=true" >> "$GITHUB_OUTPUT"
            echo "Notification test mode enabled; no target will be tested."
          else
            echo "test_mode=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Create notification test marker
        if: steps.notification_test.outputs.test_mode == 'true'
        run: |
          set -euo pipefail
          cat > result/TEST-NOTIFICATION.md <<'EOF'
          # Automation notification test

          - Status: TEST ONLY
          - Target tested: none
          - Confirmed vulnerabilities: none
          - Purpose: verify the workflow and Discord notification path

          This run intentionally did not test any target and did not create a
          confirmed vulnerability.
          EOF
          echo "Created result/TEST-NOTIFICATION.md"

      - name: Start Chrome MCP and run agent
        if: steps.notification_test.outputs.test_mode != 'true'
        timeout-minutes: 340
        env:
          AGENT_IDLE_TIMEOUT_SECONDS: "120"
          AGENT_MAX_ATTEMPTS: "3"
          AGENT_MAX_RECOVERIES: "1"
        run: |
          set -euo pipefail
          bash tools/chrome-mcp-start.sh

          BASE_CMD="$(cat tools/cmd.txt)"
          MODEL="$(awk '{for (i=1;i<=NF;i++) if ($i=="--model") {print $(i+1); exit}}' tools/cmd.txt)"
          RESUME_PROMPT='The previous attempt stalled. Read skills/AGENT.md and result/ inventory, then continue the authorized scan. Do not repeat completed work. Checkpoint confirmed findings immediately and continue with all remaining routes.'
          if [ -n "$MODEL" ]; then
            RESUME_CMD="opencode run --continue --model $MODEL '$RESUME_PROMPT'"
            FRESH_CMD="opencode run --model $MODEL '$RESUME_PROMPT'"
          else
            RESUME_CMD="opencode run --continue '$RESUME_PROMPT'"
            FRESH_CMD="opencode run '$RESUME_PROMPT'"
          fi

          LOG=result/logs/opencode.log
          mkdir -p result/logs
          touch "$LOG"
          {
            echo
            echo "===== OPENCODE RUN ${GITHUB_RUN_ID:-local} $(date -u +%Y-%m-%dT%H:%M:%SZ) ====="
          } >> "$LOG"
          tail -n 0 -F "$LOG" &
          TAIL_PID=$!

          RESTART_MARKER="${RUNNER_TEMP:-/tmp}/opencode-auto-restart-requested"
          rm -f "$RESTART_MARKER"
          MAX_ATTEMPTS="${AGENT_MAX_ATTEMPTS:-3}"
          MAX_RECOVERIES="${AGENT_MAX_RECOVERIES:-1}"
          RECOVERY=0
          ATTEMPT=1
          FINAL_STATUS=0
          WATCHDOG_EXHAUSTED=0

          reinstall_opencode() {
            REINSTALL_LOG="result/logs/opencode-reinstall-$(date -u +%Y%m%dT%H%M%SZ).log"
            {
              echo "time=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
              echo "reason=agent idle watchdog exhausted ${MAX_ATTEMPTS} attempts"
              echo "home=$HOME"
            } > "$REINSTALL_LOG"
            rm -rf "$HOME/.local/share/opencode" "$HOME/.local/state/opencode" "$HOME/.config/opencode" "$HOME/.cache/opencode" "$HOME/.local/bin/opencode" "$HOME/.opencode"
            curl -fsSL https://opencode.ai/install | bash >> "$REINSTALL_LOG" 2>&1
            export PATH="$HOME/.opencode/bin:$PATH"
            "$HOME/.opencode/bin/opencode" --version >> "$REINSTALL_LOG" 2>&1
          }

          while :; do
            WATCHDOG_EXHAUSTED=0
            while [ "$ATTEMPT" -le "$MAX_ATTEMPTS" ]; do
              if [ "$RECOVERY" -gt 0 ]; then
                CMD="$FRESH_CMD"
              elif [ "$ATTEMPT" -eq 1 ]; then
                CMD="$BASE_CMD"
              elif [ "$ATTEMPT" -eq 2 ]; then
                CMD="$RESUME_CMD"
              else
                CMD="$FRESH_CMD"
              fi
              {
                echo
                echo "===== AGENT ATTEMPT $ATTEMPT/$MAX_ATTEMPTS (recovery $RECOVERY/$MAX_RECOVERIES) ====="
              } >> "$LOG"

              set +e
              timeout --signal=TERM --kill-after=60 20160 bash -c "$CMD" >>"$LOG" 2>&1 &
              AGENT_PID=$!

              LAST_SIZE=$(stat -c %s "$LOG" 2>/dev/null || echo 0)
              LAST_CHANGE=$(date +%s)
              WATCHDOG_KILLED=0
              while kill -0 "$AGENT_PID" 2>/dev/null; do
                sleep 10
                SIZE=$(stat -c %s "$LOG" 2>/dev/null || echo 0)
                NOW=$(date +%s)
                if [ "$SIZE" -gt "$LAST_SIZE" ]; then
                  LAST_SIZE=$SIZE
                  LAST_CHANGE=$NOW
                elif [ $((NOW - LAST_CHANGE)) -ge "${AGENT_IDLE_TIMEOUT_SECONDS:-120}" ]; then
                  WATCHDOG_KILLED=1
                  {
                    echo
                    echo "WATCHDOG: no agent output for ${AGENT_IDLE_TIMEOUT_SECONDS:-120}s; terminating attempt $ATTEMPT."
                    echo "WATCHDOG: time=$(date -u +%Y-%m-%dT%H:%M:%SZ) log_bytes=$SIZE"
                  } >> "$LOG"
                  pkill -TERM -f '(^|/)[o]pencode run' 2>/dev/null || true
                  sleep 5
                  pkill -KILL -f '(^|/)[o]pencode run' 2>/dev/null || true
                  kill -TERM "$AGENT_PID" 2>/dev/null || true
                  sleep 2
                  kill -KILL "$AGENT_PID" 2>/dev/null || true
                  break
                fi
              done
              wait "$AGENT_PID"
              STATUS=$?
              set -e

              if [ "$WATCHDOG_KILLED" -eq 1 ]; then
                FINAL_STATUS=124
                if [ "$ATTEMPT" -lt "$MAX_ATTEMPTS" ]; then
                  echo "WATCHDOG: restarting agent (attempt $((ATTEMPT+1))/$MAX_ATTEMPTS)" >> "$LOG"
                  ATTEMPT=$((ATTEMPT+1))
                  sleep 5
                  continue
                fi
                echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) attempt=$ATTEMPT status=124 watchdog=true recovery=$RECOVERY" >> result/logs/agent-exit-code.txt
                {
                  echo "watchdog_terminated=true"
                  echo "watchdog_terminated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
                  echo "last_log_bytes=$LAST_SIZE"
                  echo "attempts=$ATTEMPT"
                  echo "recovery=$RECOVERY"
                } >> result/logs/agent-watchdog.txt
                if [ "$RECOVERY" -gt 0 ]; then
                  {
                    echo "time=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
                    echo "reason=no output for ${AGENT_IDLE_TIMEOUT_SECONDS:-120}s after OpenCode reinstall"
                    echo "run_id=${GITHUB_RUN_ID:-local}"
                  } > result/logs/auto-restart-requested.txt
                  printf 'requested\n' > "$RESTART_MARKER"
                fi
                WATCHDOG_EXHAUSTED=1
                break
              fi

              echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) attempt=$ATTEMPT status=$STATUS recovery=$RECOVERY" >> result/logs/agent-exit-code.txt
              if [ "$STATUS" -eq 0 ]; then
                FINAL_STATUS=0
                break
              fi
              FINAL_STATUS=$STATUS
