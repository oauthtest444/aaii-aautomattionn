    for m in re.findall(r'["\'](/[A-Za-z0-9_./{}$:%-]*(?:api|financial|bill|payment|trade|invoice|qualification|order|refund|withdraw|recharge)[A-Za-z0-9_./{}$:%-]*)["\']', s):
