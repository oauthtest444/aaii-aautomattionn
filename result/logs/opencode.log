import json, time, sys
import websocket

WS = sys.argv[1]
ROUTES = sys.argv[2:]

class CDP:
    def __init__(self, ws):
        self.ws=ws; self.id=0
    def send(self, method, params=None):
        self.id+=1
        self.ws.send(json.dumps({"id":self.id,"method":method,"params":params or {}}))
        return self.id
    def wait_id(self, mid, timeout=20):
        end=time.time()+timeout
        while time.time()<end:
            self.ws.settimeout(max(0.1,end-time.time()))
            try: msg=json.loads(self.ws.recv())
            except Exception: continue
            if msg.get("id")==mid: return msg
        raise TimeoutError(mid)
    def call(self, method, params=None, timeout=20):
        mid=self.send(method,params)
        return self.wait_id(mid,timeout)

def main():
    ws=websocket.create_connection(WS,timeout=30)
    c=CDP(ws)
    c.call("Page.enable"); c.call("Network.enable"); c.call("Runtime.enable")
    for route in ROUTES:
        url=f"https://console.byteplus.com/finance/{route}"
        mid=c.send("Page.navigate",{"url":url})
        reqs={}
        end=time.time()+5.5
        while time.time()<end:
            ws.settimeout(max(0.05,end-time.time()))
            try: msg=json.loads(ws.recv())
            except Exception: continue
            m=msg.get("method")
            if m=="Network.requestWillBeSent":
                p=msg["params"]; r=p["request"]
                if "console.byteplus.com/api/" in r.get("url",""):
                    reqs[p["requestId"]]={"method":r["method"],"url":r["url"],"postData":r.get("postData"),"type":p.get("type")}
            elif m=="Network.loadingFinished":
                pass
        # get response status/body
        print(f"\n===== /finance/{route} =====")
        for rid,info in reqs.items():
            body=None
            try:
                rb=c.call("Network.getResponseBody",{"requestId":rid},timeout=8)
                body=rb.get("result",{}).get("body")
            except Exception:
                pass
            print(json.dumps({"method":info["method"],"url":info["url"],"postData":info["postData"],"body":(body or "")[:800]},ensure_ascii=False))
    print("DONE")

if __name__=="__main__":
    main()
====
import json, time, sys
import websocket

WS = sys.argv[1]
ROUTES = [
 "overview","bill/detail","bill/tag","bill/split-bill","bill/cost-bill","bill/cost-analyse",
 "bill/report","order","renew","unsubscribe","instance-manage","resource-package","saving-plan",
 "opening-service/ECS","payment/transactions","payment/make-payment","payment/payment-methods",
 "coupon","pickup-coupon","invoice-manage","busniess-finance/relation","contract-discount","contract","export"
]

class CDP:
    def __init__(self, ws):
        self.ws=ws; self.id=0
    def call(self, method, params=None, timeout=30):
        self.id+=1; mid=self.id
        self.ws.send(json.dumps({"id":mid,"method":method,"params":params or {}}))
        end=time.time()+timeout
        while time.time()<end:
            self.ws.settimeout(max(0.1,end-time.time()))
            try: msg=json.loads(self.ws.recv())
            except Exception: continue
            if msg.get("id")==mid: return msg
        raise TimeoutError(method)
    def eval(self, expr, timeout=20):
        r=self.call("Runtime.evaluate",{"expression":expr,"returnByValue":True,"awaitPromise":True},timeout)
        res=r.get("result",{})
        if "exceptionDetails" in res: raise RuntimeError(res["exceptionDetails"])
        return res.get("result",{}).get("value")

def main():
    ws=websocket.create_connection(WS,timeout=30)
    c=CDP(ws)
    c.call("Page.enable"); c.call("Runtime.enable")
    out={}
    for route in ROUTES:
        url=f"https://console.byteplus.com/finance/{route}"
        try:
            c.call("Page.navigate",{"url":url},timeout=40)
        except Exception as e:
            out[route]={"err":"nav "+str(e)}; print(route,"NAVERR"); continue
        time.sleep(3.2)
        try:
            st=c.eval("""(()=>{
              const rs=performance.getEntriesByType('resource').map(r=>r.name)
                .filter(n=>n.includes('/api/')||n.includes('console.byteplus.com/signin/'));
              return {url:location.href, title:document.title, apis:[...new Set(rs)].sort()};
            })()""")
        except Exception as e:
            st={"err":str(e)}
        out[route]=st
        apis=st.get("apis",[]) if isinstance(st,dict) else []
        print(f"{route}: {st.get('url','')} apis={len(apis)}")
        for a in apis:
            print("   ",a[:180])
    open("/tmp/routes_api.json","w").write(json.dumps(out,indent=2))
    print("WROTE /tmp/routes_api.json")

if __name__=="__main__":
    main()
